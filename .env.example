# Copy to .env (or set in your environment / docker-compose)

# Port the server listens on
PORT=5302

# Password for the admin dashboard (CHANGE THIS)
ADMIN_PASSWORD=changeme

# Public base URL used in QR codes and copied links, e.g. https://go.yourbrand.com
# Leave empty to use the request host.
BASE_URL=

# Default redirect status for new links: 301 (permanent) or 302 (temporary)
DEFAULT_REDIRECT_TYPE=302

# SQLite database location (docker-compose mounts ./data)
DB_PATH=./data/links.db
